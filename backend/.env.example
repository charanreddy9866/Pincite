# AI provider. Set ONE key, or none to run without AI (search, OCR, redaction and
# pattern chronologies still work). If both are set, OpenAI is used.

# Free: Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Paid: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding search on top of keyword search (default: on for OpenAI, off for Gemini to save free quota)
EMBEDDINGS=

DATABASE_PATH=data/pincite.db
# Set to require a code (X-Access-Code header) for every API call.
ACCESS_CODE=
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25
OCR_ENABLED=true
