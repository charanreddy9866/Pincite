# Leave empty to run without AI: search, OCR, redaction and pattern chronologies still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_PATH=data/pincite.db
# Set to require a code (X-Access-Code header) for every API call.
ACCESS_CODE=
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25
OCR_ENABLED=true
